{
  "name": "sanyi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "engines": "node tools/fetch-engines.mjs",
    "engines:check": "node tools/fetch-engines.mjs --check",
    "bench:katago": "tsx tools/bench-katago.ts",
    "bridge": "tsx packages/bridge/src/main.ts",
    "web": "npm run dev -w @sanyi/web",
    "web:build": "npm run build -w @sanyi/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}